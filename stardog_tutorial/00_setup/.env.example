# Copy to the project root as .env and fill in.
# STARDOG_USERNAME must be a user created on the Stardog server
# (Studio > Security > Users), NOT your cloud.stardog.com login.
STARDOG_ENDPOINT=https://<your-endpoint>.stardog.cloud:5820
STARDOG_USERNAME=<server user>
STARDOG_PASSWORD=<password>
STARDOG_DATABASE=<database name>
