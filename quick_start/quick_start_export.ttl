<http://example.org/quickstart#dave> a <http://example.org/quickstart#Person> ;
   <http://example.org/quickstart#name> "Dave" ;
   <http://example.org/quickstart#age> 42 ;
   <http://example.org/quickstart#worksFor> <http://example.org/quickstart#initech> ;
   <http://example.org/quickstart#role> "Architect" .
