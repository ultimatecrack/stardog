   <http://example.org/quickstart#name> "Initech" ;
   <http://example.org/quickstart#city> "Hyderabad" .
<http://example.org/quickstart#alice> a <http://example.org/quickstart#Person> ;
   <http://example.org/quickstart#name> "Alice" ;
   <http://example.org/quickstart#age> 30 ;
   <http://example.org/quickstart#worksFor> <http://example.org/quickstart#acme> ;
   <http://example.org/quickstart#role> "Data Engineer" ;
