<http://example.org/quickstart#carol> a <http://example.org/quickstart#Person> ;
   <http://example.org/quickstart#name> "Carol" ;
   <http://example.org/quickstart#age> 28 ;
   <http://example.org/quickstart#worksFor> <http://example.org/quickstart#globex> ;
